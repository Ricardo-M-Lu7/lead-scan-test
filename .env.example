# For a stable public test domain, set this to its HTTPS address.
# Leave unset when testing through a temporary trycloudflare.com address.
PUBLIC_BASE_URL=https://lead-test.example.com

# Required to view the protected scan statistics endpoint.
ADMIN_KEY=replace-with-a-long-random-value

# Required for the Lead Management sign-in page at /admin.
# Set both values as environment variables before starting the service.
ADMIN_PASSWORD=replace-with-a-strong-administrator-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-signing-secret
